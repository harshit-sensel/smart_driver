<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/parkingname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parking spot name"
                android:textColor="@color/black"
                android:layout_marginRight="20dp"
                android:textSize="18dp"
                android:textStyle="bold" />

            <View
                android:layout_width="50dp"
                android:layout_height="3dp"

                android:layout_marginHorizontal="10dp"
                android:background="#E8E7E7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Estimated arrival time"
                android:textColor="@color/black"
                android:textSize="15dp"
                android:textStyle="bold" />

            <View
                android:layout_width="20dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="10dp"
                android:background="#E8E7E7" />


            <TextView
                android:id="@+id/etaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="ETA"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="#E8E7E7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actual arrive time"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />

            <View
                android:layout_width="20dp"
                android:layout_height="3dp"

                android:layout_marginHorizontal="10dp"
                android:background="#E8E7E7" />


            <TextView
                android:id="@+id/ataTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:drawablePadding="5dp"
                android:text="ATA"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="#E8E7E7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELAY"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />


            <View
                android:layout_width="20dp"
                android:layout_height="3dp"

                android:layout_marginHorizontal="10dp"
                android:background="#E8E7E7" />


            <TextView
                android:id="@+id/delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Not arrived"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="#E8E7E7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rest time"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resttime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="ETA"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="#E8E7E7" />

        </LinearLayout>


        <ImageView
            android:id="@+id/parkingicon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:padding="10dp"
            android:src="@drawable/ic_parking_sign" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_above="@id/viewmap"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:background="#E8E7E7" />

        <Button
            android:id="@+id/delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:text="Delete"
            android:textColor="#BF0000"
            android:textSize="12dp" />


        <Button
            android:id="@+id/viewmap"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:text="View in map"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="12dp" />

    </RelativeLayout>




</androidx.cardview.widget.CardView>


