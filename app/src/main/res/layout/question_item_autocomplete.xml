<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="5dp">

    <FrameLayout
        android:id="@+id/relativeLayoutWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_border_transparent"
            android:backgroundTint="@color/light_blue_200"
            android:dropDownSelector="@color/black"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                android:id="@+id/autoComplete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white"
                android:completionThreshold="0"
                android:dropDownAnchor="@+id/relativeLayoutWrapper"
                android:dropDownHeight="200dp"
                android:minHeight="50dp"
                android:padding="5dp"
                android:textSize="@dimen/heading_16"
                android:windowSoftInputMode="adjustPan" />
            <!--style="@style/Base.Widget.AppCompat.Spinner"-->

        </RelativeLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@color/white"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Title"
            android:textColor="@color/black_900"
            android:textSize="@dimen/heading_16" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/linearLayoutAutocompleteData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>