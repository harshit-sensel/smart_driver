<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minWidth="575dp"
            android:minHeight="250dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_border_blue"
                android:padding="30dp"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:gravity="center"
                    android:text="@string/Choseanoption"
                    android:textColor="@color/black_900"
                    android:textSize="18sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/green"
                        android:id="@+id/safetygreenlighttxt"

                        android:gravity="center_horizontal"
                        android:text="Completed safety green light checks"/>




                <Button
                    android:id="@+id/safety_green_check"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/yes_button"
                    android:paddingLeft="25dp"
                    android:paddingRight="25dp"
                    android:text="@string/Safteygreenlightcheck"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp"

                    android:id="@+id/lifesavingtxt"
                    android:gravity="center_horizontal"
                    android:textColor="@color/green"
                    android:text="Completed life saving  checks"/>

                <Button
                    android:id="@+id/life_saving_check"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/yes_button"
                    android:paddingLeft="25dp"
                    android:paddingRight="25dp"
                    android:text="@string/LifeSavingChecks"
                    android:textColor="@color/white" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</FrameLayout>
