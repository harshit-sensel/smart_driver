<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MapsActivity">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.cardview.widget.CardView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:elevation="5dp"
        android:background="#8CFFFFFF"
        app:cardCornerRadius="5dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:background="#8CFFFFFF"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accident spot-25 kp/h"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_round"
                android:drawableTint="@color/panicred"
                android:drawablePadding="5dp"
                android:padding="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="parking, rest area"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_round"
                android:drawableTint="@color/green"
                android:drawablePadding="5dp"
                android:padding="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="blind spot- 35 kp/h"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_round"
                android:drawableTint="#FFE500"
                android:drawablePadding="5dp"
                android:padding="5dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Route- 60 kp/h"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/ic_round"
                android:drawableTint="#3F51B5"

                android:drawablePadding="5dp"
                android:padding="5dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>

