<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Name or Address Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nameoraddress"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Name or Address Input (expands dynamically with zero overlap) -->
        <EditText
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Place Name"
            android:textSize="14sp" />

        <!-- Category Label (Fixes duplicate 'Comments' bug) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/category"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Category Dropdown Spinner -->
        <Spinner
            android:id="@+id/category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="36dp"
            android:popupBackground="#50c9f1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="4dp"
            android:background="@color/black" />

        <!-- Comments Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/comments"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Comments Input -->
        <EditText
            android:id="@+id/comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Comments"
            android:textSize="14sp" />

        <!-- Location on Map Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/locationonmap"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Map Preview WebView -->
        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="6dp" />

        <!-- Attach Images Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/attachimages"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Image Pickers Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:onClick="onClick"
                android:src="@drawable/file_add" />

            <ImageView
                android:id="@+id/img2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:onClick="onClick"
                android:src="@drawable/file_add"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/img3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:onClick="onClick"
                android:src="@drawable/file_add"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
